# mf-free-tools static v1: /free-tools/ is served as plain files (the PHP router is never reached for real files/dirs).
# Header "set" (not "always") on purpose: it replaces the parent public/.htaccess values in the same table instead of adding duplicates.
DirectoryIndex index.html
# --- mf-free-tools slash fix v1 (begin) ---
# The docroot is the repo root and /.htaccess rewrites into public/, so mod_dir's automatic slash redirect leaked /public/ into URLs.
DirectorySlash Off
# The bare folder itself (/free-tools or /public/free-tools) is not seen by mod_rewrite here, so use mod_alias
RedirectMatch 301 ^/(?:public/)?free-tools$ /free-tools/
<IfModule mod_rewrite.c>
    RewriteEngine On
    # /public/free-tools/<dir> (no slash) -> /free-tools/<dir>/   (THE_REQUEST = what the browser asked for)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{THE_REQUEST} ^\S+\s/(?:public/)?free-tools(/[^?\s]*[^/?\s])[?\s]
    RewriteRule ^ /free-tools%1/ [R=301,L,NE]
    # /public/free-tools/... -> /free-tools/...
    RewriteCond %{THE_REQUEST} ^\S+\s/public/free-tools(/[^?\s]*)?[?\s]
    RewriteRule ^ /free-tools%1 [R=301,L,NE]
</IfModule>
# --- mf-free-tools slash fix v1 (end) ---
Options -Indexes
ErrorDocument 404 /free-tools/404.html
AddType application/wasm .wasm
AddType application/javascript .js .mjs
AddType application/json .json
AddType application/octet-stream .onnx
AddType application/xml .xml
<IfModule mod_rewrite.c>
    RewriteEngine On
    # anything that isn't a real file or folder under /free-tools/ -> our own 404 (not the PHP app)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [R=404,L]
</IfModule>
<IfModule mod_headers.c>
    # Same-origin only; 'wasm-unsafe-eval' is needed for the background remover's WebAssembly AI engine.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    # The site default blocks camera/mic; the mic test, webcam test, voice and screen recorders need them (still asks the user).
    Header set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=600"
    </FilesMatch>
    <FilesMatch "\.(wasm|mjs|onnx)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
